# Copy to .env and fill in. Never commit .env.

# From @BotFather
BOT_TOKEN=123456:REPLACE_ME

# Bot username without @
BOT_USERNAME=your_bot_username

# Comma-separated Telegram group/supergroup chat ids
# Example: -1001234567890,-1009876543210
ALLOWED_CHAT_IDS=-1001234567890

# Optional: HTTP adapter for your existing RAG API (see bot/rag.py)
# RAG_HTTP_URL=https://your-rag.example.com/ask
# RAG_HTTP_TOKEN=replace_me
# RAG_HTTP_TIMEOUT_SEC=60
